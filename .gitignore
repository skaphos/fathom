# Binaries
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
Dockerfile.cross

# Test artifacts
*.test
*.out
coverage.out
coverage
cover*.out
*.coverprofile

# Go workspace
go.work
go.work.sum

# Build artifacts
dist/

# Generated Kubernetes files (keep vendored)
!vendor/**/zz_generated.*

# IDE
.idea/
.vscode/
*.swp
*.swo
.codex
# Agent-local state (settings.local.json, worktrees/) stays untracked, but the
# spec-kit command skills are checked in: .specify/ already tracks the spec-kit
# engine — templates, scripts, and the constitution — so leaving the commands
# that drive it agent-local means a fresh clone gets the engine with no way to
# run it. That is exactly how they went missing once already.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/speckit-*/
.cursor/
.windsurf/
.continue/
.aider*
.agents/

# OS
.DS_Store
Thumbs.db

# Local junk
.cache/
.gocache

# Design docs (local-only)
DESIGN.md

# Graphify
# Commit the rendered graph (graph.json, graph.html, GRAPH_REPORT.md,
# manifest.json) so any agent or contributor has the same map without
# re-running extraction. Keep transient work files, the per-developer cache,
# and cost telemetry out.
/.graphify_*
graphify-out/.*
graphify-out/cache/
graphify-out/cost.json
